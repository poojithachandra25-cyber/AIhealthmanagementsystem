{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-claude-md.js\"",
            "timeout": 15,
            "onFailure": "block",
            "statusMessage": "Checking CLAUDE.md protection"
          }
        ]
      }
    ]
  }
}
