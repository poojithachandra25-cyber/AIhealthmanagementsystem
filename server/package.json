{
  "name": "medpoint-server",
  "version": "1.0.0",
  "description": "Node + Express API for the MedPoint Hospital Management System",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:init": "node -e \"require('./src/db').initDatabase().then(()=>{console.log('Database ready');process.exit(0)}).catch(e=>{console.error(e.message);process.exit(1)})\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6"
  }
}
