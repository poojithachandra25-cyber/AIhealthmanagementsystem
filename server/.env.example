# Copy to server/.env (git-ignored) and fill in. Never commit the real .env.

# Required
DB_PASSWORD=
# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional (defaults shown)
# PORT=3000
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_NAME=hospitalmanagement
# GST_RATE=18

# Chatbot (optional)
# ANTHROPIC_API_KEY=
# CHAT_MODEL=claude-opus-5-5
